<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationTitle>AutoCorrect Feature Debug Lab</ApplicationTitle>
    <RootNamespace>FeatureDebugLab</RootNamespace>
    <RollForward>LatestMajor</RollForward>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AutoCorrect.Core\AutoCorrect.Core.csproj" />
    <ProjectReference Include="..\..\src\AutoCorrect.Platform.Abstractions\AutoCorrect.Platform.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\AutoCorrect.Platform.Windows\AutoCorrect.Platform.Windows.csproj" />
  </ItemGroup>
</Project>
