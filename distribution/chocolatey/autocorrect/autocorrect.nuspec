<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>autocorrect</id>
    <version>0.2.23</version>
    <title>AutoCorrect</title>
    <authors>AutoCorrect</authors>
    <owners>AutoCorrect</owners>
    <projectUrl>https://badatcoding12345678910.github.io/AutoCorrect-Windows/</projectUrl>
    <docsUrl>https://badatcoding12345678910.github.io/AutoCorrect-Windows/</docsUrl>
