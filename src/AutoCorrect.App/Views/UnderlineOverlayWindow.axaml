<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AutoCorrect.App.Views.UnderlineOverlayWindow"
        Title="Underline"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False"
        IsHitTestVisible="False"
        Width="40"
        Height="24"
        WindowStartupLocation="Manual">
    <!-- Soft purple highlight + underline over the active mistake (Grammarly-style) -->
    <Border Background="Transparent">
        <Grid>
            <Border x:Name="Fill"
                    CornerRadius="2"
                    Background="{StaticResource AcPurpleBrush}"
                    Opacity="0.22" />
            <Border x:Name="Line"
                    Height="3"
                    VerticalAlignment="Bottom"
                    CornerRadius="1.5"
                    Background="{StaticResource AcPurpleBrush}"
                    Opacity="0.95"
                    Margin="0,0,0,0" />
        </Grid>
    </Border>
</Window>
