<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AutoCorrect.App.Views.AutoLearnPromptWindow"
        Title="Auto-learn"
        Width="320"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="Manual"
        WindowDecorations="None"
        Background="Transparent"
        Icon="/Assets/autocorrect-icon.jpg"
        Topmost="True"
        ShowInTaskbar="False">

    <Border Padding="14,12,14,14"
            Margin="6"
            Background="{StaticResource AcSurfaceBrush}"
            BorderBrush="{StaticResource AcBorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            BoxShadow="0 22 50 0 #8C000000">
        <StackPanel Spacing="10">
            <TextBlock Text="AUTO-LEARN"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{StaticResource AcTextMutedBrush}" />
            <WrapPanel Orientation="Horizontal">
                <TextBlock x:Name="PairText"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AcPurpleBrush}"
                           TextWrapping="Wrap" />
            </WrapPanel>
            <TextBlock x:Name="DetailText"
                       FontSize="12"
                       Foreground="{StaticResource AcTextMutedBrush}"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Accept"
                        Padding="14,7"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Background="{StaticResource AcPurpleGlowBrush}"
                        Foreground="{StaticResource AcTextBrush}"
                        BorderBrush="{StaticResource AcPurpleBrush}"
                        BorderThickness="1"
                        CornerRadius="999"
                        Click="OnAccept" />
                <Button Content="Skip"
                        Padding="14,7"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Background="Transparent"
                        BorderBrush="{StaticResource AcBorderSoftBrush}"
                        BorderThickness="1"
                        Foreground="{StaticResource AcTextMutedBrush}"
                        CornerRadius="999"
                        Click="OnSkip" />
                <Button Content="Never"
                        Padding="14,7"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Background="Transparent"
                        BorderBrush="{StaticResource AcBorderSoftBrush}"
                        BorderThickness="1"
                        Foreground="{StaticResource AcTextMutedBrush}"
                        CornerRadius="999"
                        Click="OnNever" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
