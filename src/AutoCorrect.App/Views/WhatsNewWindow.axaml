<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AutoCorrect.App.ViewModels"
        x:Class="AutoCorrect.App.Views.WhatsNewWindow"
        x:DataType="vm:WhatsNewViewModel"
        Title="What's New"
        Width="460"
        Height="420"
        MinWidth="360"
        MinHeight="300"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AcWindowBackgroundBrush}"
        Icon="/Assets/autocorrect-icon.jpg">

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,14">
            <TextBlock Text="WHAT'S NEW"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{StaticResource AcTextMutedBrush}" />
            <TextBlock Text="{Binding VersionLabel}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AcTextBrush}" />
            <TextBlock Text="{Binding Subtitle}"
                       FontSize="12"
                       Foreground="{StaticResource AcTextMutedBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Button DockPanel.Dock="Bottom"
                Content="Close"
                Classes="ac-ghost"
                Command="{Binding CloseCommand}"
                HorizontalAlignment="Right"
                Padding="14,7"
                Margin="0,14,0,0" />

        <Border Classes="ac-panel">
            <ScrollViewer>
                <TextBlock Text="{Binding Notes}"
                           FontSize="14"
                           LineHeight="22"
                           Foreground="{StaticResource AcTextBrush}"
                           TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
